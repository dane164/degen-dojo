-- Global settings for the Black Square UI element
local square = {
    x = 100,      -- X position (from the left of the window)
    y = 100,      -- Y position (from the top of the window)
    width = 150,  -- Width of the square
    height = 150  -- Height of the square
}

-- 1. The Draw Function: Renders graphics every frame
function love.draw()
    -- Set the drawing color to black (R=0, G=0, B=0, A=1)
    love.graphics.setColor(0, 0, 0, 1)

    -- Draw a filled rectangle using the defined properties
    -- Arguments: "fill", x, y, width, height
    love.graphics.rectangle("fill", square.x, square.y, square.width, square.height)

    -- Optional: Draw a border around it in a different color (e.g., white)
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.rectangle("line", square.x, square.y, square.width, square.height)
end

-- 2. The Update Function (not strictly needed for a static square, but good practice)
function love.update(dt)
    -- dt is the time elapsed since the last frame (delta time)
end

-- 3. The Load Function (Optional: Setting the window title)
function love.load()
    love.window.setTitle("Black Square UI Example")
end
